<Project>

  <!--
    Balíček SQLitePCLRaw.lib.e_sqlcipher kopíruje do výstupu nativní knihovny pro všechny platformy
    (runtimes\win-x86, win-arm, …). Aplikace běží jen jako x64, takže do výstupu patří pouze
    runtimes\win-x64\native\e_sqlcipher.dll (zadání, sekce 3) – ostatní se zahodí ještě před kopírováním.
  -->
  <Target Name="KeepOnlyWinX64NativeLibraries" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_ForeignNativeLibrary Include="@(Content)"
                             Condition="$([System.String]::Copy('%(Content.Link)').StartsWith('runtimes\'))
                                        And !$([System.String]::Copy('%(Content.Link)').StartsWith('runtimes\win-x64\'))" />
      <Content Remove="@(_ForeignNativeLibrary)" />
    </ItemGroup>
  </Target>

  <!--
    U projektu .exe si SDK samo odvodí RuntimeIdentifier (win-x64) a NuGet pak nativní knihovnu zkopíruje
    ještě jednou – do kořene výstupu. Aplikace ji načítá z runtimes\win-x64\native (tam ji dodává projekt
    Data), takže kopie v kořeni by jen zbytečně zvětšovala ZIP (~1,8 MB).
  -->
  <Target Name="RemoveDuplicateNativeLibraries" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(NativeCopyLocalItems)" />
    </ItemGroup>
  </Target>

</Project>
