<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- x64 kvůli nativní knihovně SQLite (e_sqlcipher.dll). -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- Uživatel spouští VolejbalVrsovice.exe (zadání, sekce 3). -->
    <AssemblyName>VolejbalVrsovice</AssemblyName>
    <RootNamespace>VolejbalVrsovice.App</RootNamespace>

    <!-- Ikona .exe, okna a hlavního panelu = emblém oddílu (zadání, sekce 4). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Převzaté logo oddílu (nekreslí se ani nepřekresluje). Příprava: zmenšení a ořez nástrojem z originálu
         https://www.volejbal-vrsovice.cz/img/picture/314/%3Adesign%3Alogofirms%3A1000000390%3Ahorizontalni-pro-tmave-pozadi.png -->
    <Resource Include="Assets\logo-horizontal.png" />
    <Resource Include="Assets\logo-emblem.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VolejbalVrsovice.Core\VolejbalVrsovice.Core.csproj" />
    <ProjectReference Include="..\VolejbalVrsovice.Data\VolejbalVrsovice.Data.csproj" />
  </ItemGroup>

</Project>
