<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- x64 kvůli nativní knihovně SQLite (e_sqlcipher.dll). -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- Uživatel spouští VolejbalVrsovice.exe (zadání, sekce 3). -->
    <AssemblyName>VolejbalVrsovice</AssemblyName>
    <RootNamespace>VolejbalVrsovice.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VolejbalVrsovice.Core\VolejbalVrsovice.Core.csproj" />
    <ProjectReference Include="..\VolejbalVrsovice.Data\VolejbalVrsovice.Data.csproj" />
  </ItemGroup>

</Project>
