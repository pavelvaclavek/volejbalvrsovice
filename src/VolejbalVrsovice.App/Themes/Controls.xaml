<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:VolejbalVrsovice.App.Helpers">

    <!-- Barvy jsou v Colors.xaml (App.xaml ho slučuje před tímto slovníkem). -->

    <!-- Převodníky -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <h:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <h:TextToVisibilityConverter x:Key="TextToVisibility" />

    <!-- ===== Okna ===================================================================== -->

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <!-- Ikona okna a hlavního panelu = emblém oddílu. -->
        <Setter Property="Icon" Value="/VolejbalVrsovice;component/Assets/app.ico" />
    </Style>

    <!-- Modální dialog: pevná šířka, výška podle obsahu, fokus na první pole. -->
    <Style x:Key="DialogWindow" TargetType="Window" BasedOn="{StaticResource AppWindow}">
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="h:WindowBehaviors.FocusFirstInput" Value="True" />
    </Style>

    <!-- Tmavě modrý pruh s logem (logo je určené jen na tmavé pozadí). -->
    <Style x:Key="HeaderBand" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
    </Style>

    <!-- ===== Texty ==================================================================== -->

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Chyba celého formuláře (např. špatné heslo). -->
    <Style x:Key="FormError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Tlačítko se vzhledem odkazu. Záměrně ne Hyperlink: ten při ovládání přes UI Automation
         (čtečky obrazovky) blokuje, dokud se neuzavře dialog, který otevřel. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="4,2">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextDecorations="Underline" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Formulářová pole ========================================================= -->

    <!-- Chyba u pole (INotifyDataErrorInfo): červený rámeček a text pod polem.
         Text se kreslí do mezery pod polem – proto mají pole spodní okraj 20 px. -->
    <ControlTemplate x:Key="FieldErrorTemplate">
        <StackPanel>
            <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                <AdornedElementPlaceholder />
            </Border>
            <TextBlock Text="{Binding [0].ErrorContent}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="1,2,0,0" />
        </StackPanel>
    </ControlTemplate>

    <Style TargetType="Label">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldErrorTemplate}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldErrorTemplate}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===== Tlačítka ================================================================= -->

    <Style x:Key="ButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="4" RadiusY="4" StrokeThickness="2" Stroke="{StaticResource AccentBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Společná šablona: plocha v barvě Background, při najetí a stisku ji ztmaví poloprůhledná vrstva
         (funguje stejně na bílém i tmavě modrém tlačítku). -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3" />
            <Border x:Name="Shade" Background="Black" Opacity="0" CornerRadius="3" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shade" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shade" Property="Opacity" Value="0.18" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Běžné tlačítko: bílé s tmavě modrým obrysem. -->
    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    </Style>

    <!-- Primární tlačítko (hlavní akce okna): tmavě modré. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="Background" Value="{StaticResource NavyBrush}" />
    </Style>

    <!-- Tlačítko v tmavě modré hlavičce: průhledné s bílým obrysem. -->
    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource HeaderMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#40FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Řada tlačítek pod dialogem: potvrzení vlevo, zrušení vpravo, zarovnáno k pravému okraji. -->
    <Style x:Key="DialogButtons" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Tenký ukazatel průběhu u delších operací (ověřování hesla trvá několik sekund). -->
    <Style x:Key="BusyBar" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!-- ===== Levé menu ================================================================ -->

    <Style x:Key="MenuItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Background" Background="Transparent" />
                        <!-- svislý akcentní proužek u vybrané položky -->
                        <Border x:Name="Marker" Width="4" HorizontalAlignment="Left" Background="Transparent" />
                        <ContentPresenter Margin="20,11,12,11" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{StaticResource LineBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Background" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter TargetName="Marker" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MenuItem}" />
    </Style>

    <!-- ===== Tabulky ================================================================== -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource WhiteBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="8,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Vybraný řádek: světle modrý podklad, text zůstává tmavý (čitelnější než bílá na modré). -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
