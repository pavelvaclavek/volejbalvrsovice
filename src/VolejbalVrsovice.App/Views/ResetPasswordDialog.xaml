<Window x:Class="VolejbalVrsovice.App.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:VolejbalVrsovice.App.Helpers"
        Title="{Binding Title}"
        Width="460"
        Style="{StaticResource DialogWindow}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />

        <TextBlock Style="{StaticResource BodyText}">
            <Run Text="Uživatel:" />
            <Run x:Name="UserText" Text="{Binding UserDescription, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <StackPanel IsEnabled="{Binding IsInputEnabled}">
            <Label Content="_Dočasné heslo" Target="{Binding ElementName=TemporaryPasswordBox}" />
            <PasswordBox x:Name="TemporaryPasswordBox" h:PasswordBoxBinding.Password="{Binding TemporaryPassword}" />

            <Label Content="Dočasné heslo _znovu" Target="{Binding ElementName=ConfirmPasswordBox}" />
            <PasswordBox x:Name="ConfirmPasswordBox" h:PasswordBoxBinding.Password="{Binding ConfirmPassword}" />
        </StackPanel>

        <TextBlock Text="{Binding PasswordHint}" Style="{StaticResource BodyText}" Margin="0,0,0,12" />

        <TextBlock x:Name="ErrorText"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource FormError}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisibility}}" />

        <ProgressBar Style="{StaticResource BusyBar}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Style="{StaticResource DialogButtons}">
            <Button x:Name="SaveButton" Content="Nastavit heslo" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button x:Name="CancelButton" Content="Zrušit" IsCancel="True" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
