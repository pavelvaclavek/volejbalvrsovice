<UserControl x:Class="VolejbalVrsovice.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Uživatelé" Style="{StaticResource Heading}" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="AddUserButton" Content="_Přidat uživatele…" Style="{StaticResource PrimaryButton}" Command="{Binding AddUserCommand}" />
            <Button x:Name="ResetPasswordButton" Content="_Reset hesla…" Command="{Binding ResetPasswordCommand}" Margin="8,0,0,0" />
            <Button x:Name="DeactivateButton" Content="_Deaktivovat" Command="{Binding DeactivateCommand}" Margin="8,0,0,0" />
            <Button x:Name="NewRecoveryCodeButton" Content="Nový _záchranný kód…" Command="{Binding NewRecoveryCodeCommand}" Margin="24,0,0,0" />
        </StackPanel>

        <!-- Vazby jsou jednosměrné: řádky jsou jen pro čtení, úpravy jdou přes dialogy. -->
        <DataGrid x:Name="UsersGrid"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Jméno" Binding="{Binding DisplayName, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Role" Binding="{Binding RoleText, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="Stav" Binding="{Binding StateText, Mode=OneWay}" Width="2*" />
                <DataGridTextColumn Header="Poslední přihlášení" Binding="{Binding LastLoginText, Mode=OneWay}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
