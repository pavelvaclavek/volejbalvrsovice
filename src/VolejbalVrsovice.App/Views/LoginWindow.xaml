<Window x:Class="VolejbalVrsovice.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:VolejbalVrsovice.App.Helpers"
        Title="Přihlášení – Volejbal Vršovice"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        h:WindowBehaviors.FocusFirstInput="True"
        Style="{StaticResource AppWindow}">

    <StackPanel Margin="28,24,28,20">
        <TextBlock Text="Přihlášení" Style="{StaticResource Heading}" />

        <StackPanel IsEnabled="{Binding IsInputEnabled}">
            <Label Content="_E-mail" Target="{Binding ElementName=EmailBox}" />
            <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <Label Content="_Heslo" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox x:Name="PasswordBox" h:PasswordBoxBinding.Password="{Binding Password}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource FormError}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisibility}}" />

        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Style="{StaticResource BusyBar}" />
            <TextBlock x:Name="StatusText"
                       Text="{Binding StatusMessage}"
                       Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}" />
        </StackPanel>

        <Button x:Name="LoginButton"
                Content="Přihlásit"
                IsDefault="True"
                Command="{Binding LoginCommand}" />

        <Button x:Name="ForgotPasswordLink"
                Content="Zapomenuté heslo"
                Style="{StaticResource LinkButton}"
                Command="{Binding ForgotPasswordCommand}"
                Margin="0,14,0,0" />
    </StackPanel>
</Window>
