<Window x:Class="VolejbalVrsovice.App.Views.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:VolejbalVrsovice.App.Helpers"
        Title="{Binding Title}"
        Width="460"
        Style="{StaticResource DialogWindow}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" />

        <StackPanel IsEnabled="{Binding IsInputEnabled}">
            <Label Content="Záchranný _kód" Target="{Binding ElementName=RecoveryCodeBox}" />
            <TextBox x:Name="RecoveryCodeBox"
                     Text="{Binding RecoveryCode, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     CharacterCasing="Upper"
                     MaxLength="40" />

            <Label Content="_E-mail správce" Target="{Binding ElementName=AdminEmailBox}" />
            <TextBox x:Name="AdminEmailBox" Text="{Binding AdminEmail, UpdateSourceTrigger=PropertyChanged}" />

            <Label Content="_Nové heslo" Target="{Binding ElementName=NewPasswordBox}" />
            <PasswordBox x:Name="NewPasswordBox" h:PasswordBoxBinding.Password="{Binding NewPassword}" />

            <Label Content="Nové heslo _znovu" Target="{Binding ElementName=ConfirmPasswordBox}" />
            <PasswordBox x:Name="ConfirmPasswordBox" h:PasswordBoxBinding.Password="{Binding ConfirmPassword}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource FormError}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisibility}}" />

        <ProgressBar Style="{StaticResource BusyBar}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Style="{StaticResource DialogButtons}">
            <Button x:Name="SubmitButton" Content="Nastavit heslo" Style="{StaticResource PrimaryButton}" IsDefault="True" Command="{Binding SubmitCommand}" />
            <Button x:Name="CancelButton" Content="Zrušit" IsCancel="True" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
