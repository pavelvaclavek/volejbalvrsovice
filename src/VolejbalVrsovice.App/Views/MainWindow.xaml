<Window x:Class="VolejbalVrsovice.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VolejbalVrsovice.App.ViewModels"
        xmlns:views="clr-namespace:VolejbalVrsovice.App.Views"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <!-- Stránky hlavního okna: ViewModel → pohled. -->
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Horní lišta: přihlášený uživatel, změna hesla, odhlášení. -->
        <Border DockPanel.Dock="Top" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText" Text="{Binding UserName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="UserRoleText" Text="{Binding UserRoleText, StringFormat=' ({0})'}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="ChangePasswordButton" Content="Změnit heslo" Command="{Binding ChangePasswordCommand}" />
                    <Button x:Name="LogoutButton" Content="Odhlásit" Command="{Binding LogoutCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="Volejbal Vršovice" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Levé menu podle role. -->
        <ListBox x:Name="MenuList"
                 DockPanel.Dock="Left"
                 Width="200"
                 BorderThickness="0,0,1,0"
                 BorderBrush="#D0D7DE"
                 ItemsSource="{Binding MenuItems}"
                 SelectedItem="{Binding SelectedMenuItem}"
                 IsEnabled="{Binding IsNavigationEnabled}"
                 DisplayMemberPath="Title" />

        <Grid Margin="20">
            <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Focusable="False" />

            <TextBlock Text="Evidence družstev, hráčů, příspěvků a akcí bude doplněna v dalších krocích."
                       Style="{StaticResource BodyText}"
                       Visibility="{Binding CurrentPage, Converter={StaticResource NullToVisible}}" />
        </Grid>
    </DockPanel>
</Window>
