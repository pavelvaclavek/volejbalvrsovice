<Window x:Class="VolejbalVrsovice.App.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:VolejbalVrsovice.App.Helpers"
        Title="{Binding Title}"
        Width="430"
        Style="{StaticResource DialogWindow}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" />

        <StackPanel IsEnabled="{Binding IsInputEnabled}">
            <StackPanel Visibility="{Binding IsForced, Converter={StaticResource InverseBoolToVisibility}}">
                <Label Content="_Současné heslo" Target="{Binding ElementName=CurrentPasswordBox}" />
                <PasswordBox x:Name="CurrentPasswordBox" h:PasswordBoxBinding.Password="{Binding CurrentPassword}" />
            </StackPanel>

            <Label Content="_Nové heslo" Target="{Binding ElementName=NewPasswordBox}" />
            <PasswordBox x:Name="NewPasswordBox" h:PasswordBoxBinding.Password="{Binding NewPassword}" />

            <Label Content="Nové heslo _znovu" Target="{Binding ElementName=ConfirmPasswordBox}" />
            <PasswordBox x:Name="ConfirmPasswordBox" h:PasswordBoxBinding.Password="{Binding ConfirmPassword}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Text="{Binding ErrorMessage}"
                   Style="{StaticResource FormError}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource TextToVisibility}}" />

        <ProgressBar Style="{StaticResource BusyBar}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Style="{StaticResource DialogButtons}">
            <Button x:Name="SaveButton" Content="Uložit heslo" IsDefault="True" Command="{Binding SaveCommand}" />
            <Button x:Name="CancelButton" Content="{Binding CancelText}" IsCancel="True" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
