<Window x:Class="VolejbalVrsovice.App.Views.RecoveryCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="520"
        Style="{StaticResource DialogWindow}">

    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
        <TextBlock Text="{Binding Explanation}" Style="{StaticResource BodyText}" />

        <!-- Kód je v poli jen pro čtení, aby šel označit a zkopírovat i klávesnicí. -->
        <Border Background="#F4F6F8" BorderBrush="#C9D1D9" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <TextBox x:Name="CodeBox"
                     Text="{Binding Code, Mode=OneWay}"
                     IsReadOnly="True"
                     IsTabStop="False"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="Consolas"
                     FontSize="21"
                     TextAlignment="Center"
                     Margin="0"
                     Padding="0" />
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="CopyButton" Content="_Kopírovat" Command="{Binding CopyCommand}" />
            <Button x:Name="PrintButton" Content="_Tisk…" Command="{Binding PrintCommand}" Margin="8,0,0,0" />
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="WarningText"
                   Text="{Binding DataLossWarning}"
                   Style="{StaticResource FormError}"
                   FontWeight="SemiBold"
                   Margin="0,8,0,16" />

        <CheckBox x:Name="ConfirmCheckBox" Content="Kód jsem si _bezpečně uložil" IsChecked="{Binding IsConfirmed}" />

        <StackPanel Style="{StaticResource DialogButtons}">
            <Button x:Name="CloseButton" Content="Pokračovat" IsDefault="True" Command="{Binding CloseCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
